{
  "name": "veille",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:scripts",
    "build:scripts": "esbuild worker=worker/index.ts migrate=scripts/migrate.ts create-user=scripts/create-user.ts reset-password=scripts/reset-password.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "create-user": "tsx --env-file-if-exists=.env scripts/create-user.ts",
    "reset-password": "tsx --env-file-if-exists=.env scripts/reset-password.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-auth": "1.7.17",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rss-parser": "3.13.0",
    "server-only": "^0.0.1",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@tailwindcss/postcss": "4.3.4",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
