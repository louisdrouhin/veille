{
  "name": "veille",
  "version": "3.2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louisdrouhin/veille.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:scripts",
    "build:scripts": "esbuild worker=worker/index.ts migrate=scripts/migrate.ts create-user=scripts/create-user.ts reset-password=scripts/reset-password.ts vapid-keys=scripts/vapid-keys.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:dev": "pglite-server --db=./.pglite --port=5432 --max-connections=10",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "create-user": "tsx --env-file-if-exists=.env scripts/create-user.ts",
    "reset-password": "tsx --env-file-if-exists=.env scripts/reset-password.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mozilla/readability": "^0.6.0",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.4",
    "linkedom": "^0.18.15",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rss-parser": "3.13.0",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "undici": "^8.12.4",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@tailwindcss/postcss": "4.3.5",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
