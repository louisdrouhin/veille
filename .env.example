# Copier en .env et remplir. Utilisé par docker compose (et par `npm run dev` en local).

# --- Image -----------------------------------------------------------------
# Obligatoire. Version de l'image publiée par la CI (ghcr.io/louisdrouhin/veille:<version>, voir les Releases).
# Mise à jour : nouvelle version ici, puis `docker compose pull && docker compose up -d`. Retour arrière :
# remettre la version précédente, puis les mêmes commandes.
APP_VERSION=2.13.0

# --- Base de données -------------------------------------------------------
POSTGRES_USER=veille
# Obligatoire. Ex. : openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=veille
# Uniquement pour le dev local hors Docker (npm run dev / worker / db:migrate / create-user / reset-password).
# Dans Docker, DATABASE_URL est construit automatiquement à partir des variables ci-dessus.
DATABASE_URL=postgres://veille:CHANGE_ME@localhost:5432/veille

# --- Authentification (Better Auth) ----------------------------------------
# URL publique exacte de l'app, telle que vue par le navigateur (derrière le reverse proxy).
# En https://, les cookies sont marqués Secure.
BETTER_AUTH_URL=https://veille.example.lan
# Obligatoire, ≥ 32 caractères aléatoires. Ex. : openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optionnel : IP ou CIDR des reverse proxies devant l'app, séparés par des virgules (ex. 172.18.0.5/32 pour
# Nginx Proxy Manager sur le même réseau Docker : voir README, « Derrière Nginx Proxy Manager »).
# Le rate limiting de la connexion identifie alors le client par la dernière IP de X-Forwarded-For
# ajoutée par le proxy. Vide : seul un X-Forwarded-For à une seule IP est pris en compte.
TRUSTED_PROXIES=

# --- Clés d'API depuis l'interface (Administration › Intégrations) ---------
# Optionnel. Clé maîtresse qui chiffre (AES-256-GCM) les clés saisies dans l'interface ; 32 octets en base64 :
#   openssl rand -base64 32
# Une clé saisie dans l'interface remplace celle de ce fichier. Vide : la page est en lecture seule et l'app
# utilise les valeurs ci-dessous. À garder : sans elle (ou avec une autre), les clés enregistrées sont illisibles.
SECRETS_KEY=

# --- Résumé et traduction (Gemini) -----------------------------------------
# Optionnel. Clé API Gemini (Google AI Studio). Vide : les boutons « Résumer » et « Traduire » sont masqués.
# Lue uniquement par le serveur (service app) ; jamais envoyée au navigateur. Offre gratuite : Google peut
# utiliser le texte envoyé (les articles, rien d'autre) pour améliorer ses produits.
GEMINI_API_KEY=
# Optionnel. Modèle des résumés (défaut : gemini-3.5-flash-lite).
GEMINI_MODEL=
# Optionnel. Modèle des traductions (défaut : gemini-3.8-flash, plus fidèle que le Lite).
GEMINI_TRANSLATE_MODEL=

# --- Demande à ta veille (recherche par le sens, questions) -----------------
# Même clé Gemini. Modèle d'embeddings (défaut : gemini-embedding-2, multilingue). Ne sont envoyés que le titre,
# le chapô et le début des articles publics : jamais une note perso ni Ma stack.
GEMINI_EMBEDDING_MODEL=
# Limites par jour (heure de Paris) : textes indexés (défaut 1000) et questions (défaut 50).
EMBED_DAILY_LIMIT=
ASK_DAILY_LIMIT=

# --- Ma stack (radar de vulnérabilités) --------------------------------------
# Optionnel. Clé de l'API NVD (https://nvd.nist.gov/developers/request-an-api-key) : 50 requêtes / 30 s au lieu
# de 5. Sans elle, la première vérification d'un gros produit (Windows Server : des milliers de CVE) prend quelques
# minutes. Lue uniquement par le serveur (app et worker).
NVD_API_KEY=
# Optionnel. Jeton GitHub en lecture seule (aucune permission) : 5 000 requêtes / h au lieu de 60 pour les avis de
# sécurité et les versions publiées.
GITHUB_TOKEN=
# Intervalle entre deux vérifications par le worker (minutes, ≥ 5).
STACK_CHECK_INTERVAL_MINUTES=30

# --- Notifications push (Ma stack) -------------------------------------------
# Optionnel. Clés VAPID, à générer une fois (voir README, « Notifications ») :
#   docker compose run --rm --no-deps app node dist/vapid-keys.js
# Vides : les notifications sont désactivées. Ne jamais les changer ensuite (les appareils abonnés
# devraient se réabonner). Lues uniquement par le serveur (app et worker) ; la clé publique est donnée
# au navigateur pour s'abonner.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optionnel. Contact pour les services de push (mailto:… ou https://…). Vide : BETTER_AUTH_URL (en https).
VAPID_SUBJECT=

# --- Worker de récupération ------------------------------------------------
# Intervalle entre deux passages (minutes, ≥ 1).
FETCH_INTERVAL_MINUTES=15
# Nombre de sources récupérées en parallèle.
FETCH_CONCURRENCY=4
# User-Agent envoyé aux flux (vide = « FoldersRSS/1.0 (+self-hosted personal feed reader) »).
FETCH_USER_AGENT=

# --- Sauvegardes (service backup) ---------------------------------------------
# Dump quotidien dans ./backups à partir de BACKUP_HOUR (heure de Paris), BACKUP_KEEP derniers conservés.
BACKUP_HOUR=3
BACKUP_KEEP=7
# UID / GID propriétaires des dumps sur l'hôte (`id -u` / `id -g`).
BACKUP_UID=1000
BACKUP_GID=1000

# --- Exposition -------------------------------------------------------------
# Port publié sur l'hôte pour le reverse proxy. Mettre APP_BIND=127.0.0.1 si le proxy est sur la même machine.
APP_PORT=3000
APP_BIND=0.0.0.0
