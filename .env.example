# Copier en .env et remplir. Utilisé par docker compose (et par `npm run dev` en local).

# --- Base de données -------------------------------------------------------
POSTGRES_USER=veille
# Obligatoire. Ex. : openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=veille
# Uniquement pour le dev local hors Docker (npm run dev / worker / db:migrate / create-user / reset-password).
# Dans Docker, DATABASE_URL est construit automatiquement à partir des variables ci-dessus.
DATABASE_URL=postgres://veille:CHANGE_ME@localhost:5432/veille

# --- Authentification (Better Auth) ----------------------------------------
# URL publique exacte de l'app, telle que vue par le navigateur (derrière le reverse proxy).
# En https://, les cookies sont marqués Secure.
BETTER_AUTH_URL=https://veille.example.lan
# Obligatoire, ≥ 32 caractères aléatoires. Ex. : openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optionnel : IP ou CIDR des reverse proxies devant l'app, séparés par des virgules (ex. 192.168.1.10).
# Le rate limiting de la connexion identifie alors le client par la dernière IP de X-Forwarded-For
# ajoutée par le proxy. Vide : seul un X-Forwarded-For à une seule IP est pris en compte.
TRUSTED_PROXIES=

# --- Worker de récupération ------------------------------------------------
# Intervalle entre deux passages (minutes, ≥ 1).
FETCH_INTERVAL_MINUTES=15
# Nombre de sources récupérées en parallèle.
FETCH_CONCURRENCY=4
# User-Agent envoyé aux flux (vide = « VeilleBot/1.0 (+self-hosted personal feed reader) »).
FETCH_USER_AGENT=

# --- Exposition -------------------------------------------------------------
# Port publié sur l'hôte pour le reverse proxy. Mettre APP_BIND=127.0.0.1 si le proxy est sur la même machine.
APP_PORT=3000
APP_BIND=0.0.0.0
